{
  "name": "pedit",
  "version": "0.2.0",
  "description": "Unified AI-assisted Jutge problem editor CLI and Problem PDF Viewer wrapping unmodified jtk",
  "type": "module",
  "bin": {
    "pedit": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "viewer": "bun run src/viewer-server.ts",
    "export": "bun run src/export-static.ts",
    "compile": "bun build ./src/index.ts --compile --outfile pedit",
    "test": "bun test"
  },
  "dependencies": {
    "@openrouter/sdk": "latest",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
